// Module-level cache that persists across component mounts/unmounts
const leagueDataCache = new Set<string>();
const leaderboardCache = new Map<string, { current: LeaderboardEntry[], overall: LeaderboardEntry[] }>();
const matchupsCache = new Map<string, any[]>();
const teamsCache = new Map<string, any[]>();
const leagueDetailsCache = new Map<string, any>();

interface League {
  id: string;
  name: string;
  max_members: number;
  picks_per_person: number;
  owner_id: string;
  status: string;
  current_tournament_id: string | null;
  league_type: 'tournament' | 'season';
  season_id: string | null;
  is_public?: boolean;
}

interface Tournament {
  id: string;
  name: string;
  start_date?: string;
  end_date?: string;
  location?: string;
  status?: string;
  time_control?: string;
  round_schedule?: string;
}

interface Team {
  id: string;
  name: string;
  user_id: string;
  username: string;
}

interface Player {
  fide_id: string;
  name: string;
  rating: number;
  rapid_rating?: number;
  blitz_rating?: number;
  country: string;
  title?: string;
  fantasy_score?: number;
  tournament_id?: string;
  tournament_name?: string;
  time_control?: string;
}

interface TeamRoster {
  team_id: string;
  players: Player[];
}

interface LeaderboardEntry {
  user_id: string;
  username: string;
  team_name: string;
  points: number;
  wins?: number;
  losses?: number;
  draws?: number;
  total_games?: number;
  classical_points?: number;
}

interface Matchup {
  id: string;
  round_number: number;
  white_player: Player;
  black_player: Player;
  status: string;
  white_classical_score: number;
  black_classical_score: number;
  white_fantasy_points?: number;
  black_fantasy_points?: number;
}

interface ChatMessage {
  id: string;
  league_id: string;
  user_id: string;
  message: string;
  created_at: string;
  username?: string;
}

type TabType = 'teams' | 'leaderboard' | 'matchups' | 'drafts';

// Helper function to get start of week (Monday)
const getStartOfWeek = (date: Date): Date => {
  const d = new Date(date);
  const day = d.getDay();
  const diff = d.getDate() - day + (day === 0 ? -6 : 1); // Adjust when day is Sunday
  return new Date(d.setDate(diff));
};

// Helper function to format date for display
const formatDateHeader = (dateStr: string): string => {
  const date = new Date(dateStr);
  const today = new Date();
  const yesterday = new Date(today);
  yesterday.setDate(yesterday.getDate() - 1);
  
  if (date.toDateString() === today.toDateString()) {
    return 'Today';
  } else if (date.toDateString() === yesterday.toDateString()) {
    return 'Yesterday';
  } else {
    return date.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' });
  }
};

